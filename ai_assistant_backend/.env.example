# ============================================================================
#  环境变量模板
# ----------------------------------------------------------------------------
#  用法：复制本文件为 .env，再把各项填成真实值。
#
#      cp .env.example .env
#
#  .env 已在 .gitignore 中，不会被提交 —— 真实密钥只留在本地。
#  新增配置项时请同时更新本文件，保持两者键名一致。
# ============================================================================

# ---------- 对话模型 ----------
# 至少配置一家。可用模型清单由 GET /model/get 返回，前端不硬编码。

# DeepSeek
DEEPSEEK_MODEL_NAME=deepseek-flash
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 阿里云百炼（OpenAI 兼容模式）
# 地址请以你自己的控制台为准，专属工作空间的端点与新开通用地址不同
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 小米 MiMo
MIMO_MODEL_NAME=mimo-v2.6-flash
MIMO_API_KEY=
MIMO_BASE_URL=https://api.xiaomimimo.com/v1

# ---------- 联网搜索工具（可选）----------
TAVILY_API_KEY=

# ---------- 数据库 ----------
# PostgreSQL 连接串，库中需要安装 pgvector 扩展，表结构见 sql/init.sql
DB_URL=postgresql://postgres:postgres@127.0.0.1:5432/zhiyu_ai

# ---------- 鉴权 ----------
# JWT 签名密钥。泄露它 = 任何人都能伪造任意用户的登录凭证，
# 务必不要提交、不要复用，换环境时重新生成一份：
#
#     python -c "import secrets; print(secrets.token_urlsafe(48))"
#
JWT_SECRET_KEY=

# ---------- 跨域 ----------
# 逗号分隔，* 表示允许所有来源。
# 鉴权走 Authorization 头、不依赖 Cookie，因此用 * 是安全的；
# 生产环境建议收敛为具体域名：
#     CORS_ORIGINS=http://localhost:5173,https://zhiyu.example.com
CORS_ORIGINS=*
