# ============================================================================
#  仓库根忽略规则
#  子项目各自还有自己的 .gitignore（如 ai_assistant_backend/.gitignore），
#  两者叠加生效。
# ============================================================================

# ---------- 环境变量 ----------
# 含 API Key、数据库密码等真实凭据，绝不能入库。
# 仓库里只提交模板 ai_assistant_backend/.env.example。
.env
.env.local
.env.*.local

# ---------- 依赖与构建产物 ----------
node_modules/
dist/
build/
.venv/
venv/
*.egg-info/

# ---------- Python 运行时产物 ----------
__pycache__/
*.py[cod]

# ---------- IDE / 编辑器 ----------
.idea/
.vscode/
*.iml

# ---------- 操作系统 ----------
.DS_Store
Thumbs.db

# ---------- 本地工具目录 ----------
# 工作记录与过程截图，不属于项目代码
.workbuddy/
